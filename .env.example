# Database (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///./campuslink.db

# Environment
ENVIRONMENT=development
PORT=8000

# Google Gemini API (Optional for offline fixtures / fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding Engine (local or api)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Matching Weights Configuration (JSON string or defaults)
SCORING_WEIGHTS={"skills":0.40,"projects":0.20,"academics":0.15,"assessment":0.10,"certifications":0.10,"communication":0.05}
