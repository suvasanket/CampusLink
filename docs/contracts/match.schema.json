{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobMatchResult",
  "type": "object",
  "required": ["job_id", "matches"],
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Identifier of the evaluated job"
    },
    "total_evaluated": {
      "type": "integer",
      "description": "Total candidate pool evaluated"
    },
    "total_eligible": {
      "type": "integer",
      "description": "Number of candidates passing hard eligibility"
    },
    "matches": {
      "type": "array",
      "description": "Rank-ordered list of evaluated candidates",
      "items": {
        "type": "object",
        "required": [
          "student_id",
          "rank",
          "eligible",
          "match_score",
          "category",
          "breakdown",
          "strengths",
          "skill_gaps",
          "explanation"
        ],
        "properties": {
          "student_id": { "type": "string" },
          "student_name": { "type": "string" },
          "rank": { "type": "integer", "minimum": 1 },
          "eligible": { "type": "boolean" },
          "match_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "category": {
            "type": "string",
            "enum": ["Highly Suitable", "Suitable", "Potential Fit", "Not Recommended", "Ineligible"]
          },
          "breakdown": {
            "type": "object",
            "required": ["skills", "projects", "academics", "assessment", "certifications", "communication"],
            "properties": {
              "skills": { "type": "number", "minimum": 0, "maximum": 100 },
              "projects": { "type": "number", "minimum": 0, "maximum": 100 },
              "academics": { "type": "number", "minimum": 0, "maximum": 100 },
              "assessment": { "type": "number", "minimum": 0, "maximum": 100 },
              "certifications": { "type": "number", "minimum": 0, "maximum": 100 },
              "communication": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "strengths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "skill_gaps": {
            "type": "array",
            "items": { "type": "string" }
          },
          "preferred_skill_gaps": {
            "type": "array",
            "items": { "type": "string" }
          },
          "explanation": { "type": "string" },
          "ineligibility_reasons": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
