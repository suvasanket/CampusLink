# CampusLink — Environment Configuration

PROJECT_NAME=CampusLink
VERSION=0.1.0

# Database Configuration (PostgreSQL primary, SQLite fallback)
DATABASE_URL=postgresql+psycopg2://localhost:5432/campuslink
FALLBACK_DATABASE_URL=sqlite:///./campuslink.db

# AI Provider Configuration (gemini, groq, or fixture)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# Local Embedding Model (zero token usage)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]
